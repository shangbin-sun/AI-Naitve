# 可选：在启动前通过 export 配置；应用不自动读取此文件。
# CODEX_BIN=/absolute/path/to/codex
# AI Team 所有模型入口默认使用 Luna；不修改 Codex 全局配置。
# CODEX_MODEL=gpt-5.6-luna
# CODEX_TIMEOUT_SECONDS=300
# CODEX_REASONING_EFFORT=medium
# FACTORY_SOURCE_ROOT=/absolute/path/to/Agent项目
# FACTORY_DATA_DIR=/absolute/path/to/data
# DATABASE_URL=postgresql+psycopg://user:password@localhost/factory
# 对话独立推理强度；未设置时继承 CODEX_REASONING_EFFORT（默认 medium）
# CODEX_CHAT_REASONING_EFFORT=medium
# 仅对项目助手禁用无关技能/插件/工具上下文，0 可回退旧配置
# FACTORY_CHAT_LEAN_CONTEXT=1
# 主智能体任务单轮超时（项目聊天仍使用 CODEX_TIMEOUT_SECONDS）
CODEX_RUN_TIMEOUT_SECONDS=1800
